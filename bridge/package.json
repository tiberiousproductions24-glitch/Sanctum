{
  "name": "sanctum-link-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relays Ableton Link tempo/beat/phase to the Sanctum web app over WebSocket",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:relay": "bash native/build.sh",
    "test-peer": "node test-peer.js",
    "build:addon": "npx node-gyp rebuild --directory node_modules/abletonlink"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "abletonlink": "0.2.0-beta.0"
  }
}
